": 0, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"type": "text", "content": "which offers a more relaxed schedule for programmers."}], "id": 1}], "id": 3}, {"_data": [{"contents": [{"type": "text", "content": "Use cases and user stories are "}], "type": "question"}, {"type": "objective", "content": "secondary_1"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"type": "text", "content": "able to perform the same functions."}], "id": 1}], "id": 4}, {"_data": [{"contents": [{"type": "rec", "content": ""}], "type": "question"}, {"type": "objective", "content": "secondary_1"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 1}], "id": 5}], "type": "MT1", "template_override": 1, "id": 3}, {"stimuli_ids": [], "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Activity 3"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2}}], "questions": [{"_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"type": "text", "content": ""}], "id": 1}], "id": 0}], "type": "EXT", "template_override": 1, "id": 4}, {"stimuli_ids": [3], "_data": [{"contents": [{"type": "text", "content": "<strong>It is time to write a summary about UML and XP!<br/>\nInstructions:</strong><br/><br/><br/>\n<span class=\"italic\">